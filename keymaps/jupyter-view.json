{
  // `alt-j` is the Jupyter family's chord prefix. ctrl-shift-n is core's
  // application:new-window, bound at body; this sits at lumine-workspace, which
  // is deeper, and DOM proximity outranks everything — so it took the keystroke
  // and there was no way to open a new window while this package was active.
  "lumine-workspace": {
    "alt-j n": "jupyter-view:new-notebook"
  },

  ".jupyter-notebook.command-mode": {
    "enter": "jupyter-view:enter-edit-mode",

    "up": "jupyter-view:focus-previous-cell",
    "down": "jupyter-view:focus-next-cell",
    "k": "jupyter-view:focus-previous-cell",
    "j": "jupyter-view:focus-next-cell",
    "home": "jupyter-view:focus-first-cell",
    "end": "jupyter-view:focus-last-cell",

    "shift-up": "jupyter-view:select-previous-cell",
    "shift-down": "jupyter-view:select-next-cell",
    "shift-k": "jupyter-view:select-previous-cell",
    "shift-j": "jupyter-view:select-next-cell",

    "a": "jupyter-view:insert-cell-above",
    "b": "jupyter-view:insert-cell-below",
    "shift-a": "jupyter-view:insert-cell-above-and-extend-selection",
    "shift-b": "jupyter-view:insert-cell-below-and-extend-selection",

    "d d": "jupyter-view:delete-cell",

    "x": "jupyter-view:cut-cell",
    "c": "jupyter-view:copy-cell",
    "v": "jupyter-view:paste-cell-below",
    "shift-v": "jupyter-view:paste-cell-above",

    "z": "jupyter-view:undo-cell-operation",
    "shift-z": "jupyter-view:redo-cell-operation",

    "y": "jupyter-view:change-cell-to-code",
    "m": "jupyter-view:change-cell-to-markdown",
    "r": "jupyter-view:change-cell-to-raw",

    "o": "jupyter-view:toggle-cell-output",
    "i": "jupyter-view:toggle-cell-input",

    "alt-pageup": "jupyter-view:scroll-up",
    "alt-pagedown": "jupyter-view:scroll-down",

    "ctrl-shift-up": "jupyter-view:move-cell-up",
    "ctrl-shift-down": "jupyter-view:move-cell-down",

    "shift-m": "jupyter-view:merge-cell-below",

    "ctrl-shift-d": "jupyter-view:duplicate-cell"
  },

  ".jupyter-notebook.edit-mode lumine-text-editor": {
    "ctrl-enter": "jupyter-view:run-cell",
    "shift-enter": "jupyter-view:run-cell-and-move-down",
    "alt-shift-enter": "jupyter-view:insert-cell-below-and-edit",
    "escape": "jupyter-view:enter-command-mode"
  },

  ".jupyter-notebook.edit-mode": {
    "ctrl-enter": "jupyter-view:run-cell",
    "shift-enter": "jupyter-view:run-cell-and-move-down",
    "alt-shift-enter": "jupyter-view:insert-cell-below-and-edit",
    "escape": "jupyter-view:enter-command-mode"
  },

  ".jupyter-notebook": {
    "ctrl-enter": "jupyter-view:run-cell",
    "shift-enter": "jupyter-view:run-cell-and-move-down",
    "ctrl-s": "jupyter-view:save",
    "ctrl-shift-s": "jupyter-view:save-as",

    // Core already binds cmdorctrl-k <direction> for these at body. Spelling
    // them ctrl-k here duplicated that off macOS and, on macOS, turned the
    // Cocoa ctrl-k (cut to end of line) into a 1000 ms wait inside every
    // notebook cell.
    "cmdorctrl-k left": "pane:split-left-and-copy-active-item",
    "cmdorctrl-k right": "pane:split-right-and-copy-active-item",
    "cmdorctrl-k up": "pane:split-up-and-copy-active-item",
    "cmdorctrl-k down": "pane:split-down-and-copy-active-item"
  },

  ".jupyter-notebook lumine-text-editor": {
    "ctrl-enter": "jupyter-view:run-cell",
    "shift-enter": "jupyter-view:run-cell-and-move-down",
    "alt-shift-enter": "jupyter-view:insert-cell-below-and-edit"
  }
}
