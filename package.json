{
  "name": "jupyter-view",
  "author": "lumine-code",
  "description": "Open and edit Jupyter notebooks.",
  "repository": "https://github.com/lumine-code/jupyter-view",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-view/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-view#readme",
  "keywords": [
    "notebook",
    "ipynb",
    "python",
    "cell",
    "kernel"
  ],
  "version": "1.1.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can start a Jupyter notebook from scratch with {{ 'jupyter-view:new-notebook' | keystroke }}",
    "In a notebook you can turn the selected cell into Markdown with {{ 'jupyter-view:change-cell-to-markdown' | keystroke }}"
  ],
  "main": "./lib/main",
  "files": [
    "docs",
    "grammars",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "benchmark:source": "lumine --test benchmark",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "deserializers": {
    "JupyterNotebookEditor": "deserializeNotebookEditor"
  },
  "consumedServices": {
    "autocomplete.watch-editor": {
      "versions": {
        "^1.0.0": "consumeAutocompleteWatchEditor"
      }
    },
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "scrollmap.widget": {
      "versions": {
        "^1.0.0": "consumeScrollmapWidget"
      }
    },
    "jupyter.output": {
      "versions": {
        "^1.0.0": "consumeJupyterOutput"
      }
    },
    "linter.editors": {
      "versions": {
        "^1.0.0": "consumeLinterEditors"
      }
    }
  },
  "providedServices": {
    "jupyter.notebook": {
      "versions": {
        "1.1.0": "provideJupyterNotebook"
      }
    },
    "jupyter.adapter": {
      "versions": {
        "1.0.0": "provideJupyterAdapter"
      }
    },
    "linter.adapter": {
      "versions": {
        "1.0.0": "provideLinterAdapter"
      }
    },
    "linter.ui": {
      "versions": {
        "1.0.0": "provideLinterUI"
      }
    },
    "navigation.adapter": {
      "versions": {
        "1.0.0": "provideNavigationAdapter"
      }
    },
    "search.adapter": {
      "versions": {
        "1.0.0": "provideSearchAdapter"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#ad65d4e2a81aa70839069309fa532635bc007b7e",
    "anser": "^2.3.5",
    "uuid": "^14.0.1"
  },
  "configSchema": {
    "notebook": {
      "title": "Notebook",
      "description": "Notebook-level settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "useOpener": {
          "title": "Use Workspace Opener",
          "description": "Open .ipynb files with jupyter-view through the Lumine workspace opener.",
          "type": "boolean",
          "default": true
        },
        "scrollPos": {
          "title": "Scroll Distance",
          "description": "How far a page scroll moves, as a fraction of the visible notebook height.",
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 1
        },
        "scrollDiv": {
          "title": "Scroll Smoothness",
          "description": "Number of steps a page scroll is animated over. Higher is smoother and slower.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "input": {
      "title": "Input Cell",
      "description": "Input cell display and editing settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "maxHeight": {
          "title": "Max Height",
          "description": "Maximum height in pixels for input cells. Zero means unlimited.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "output": {
      "title": "Output Cell",
      "description": "Output cell display settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "maxHeight": {
          "title": "Max Height",
          "description": "Maximum height in pixels for output cells before scrolling.",
          "type": "integer",
          "minimum": 100,
          "default": 1000
        }
      }
    },
    "scrollmap": {
      "title": "Scrollmap",
      "description": "Scrollmap marker settings.",
      "type": "object",
      "collapsed": true,
      "properties": {
        "enabled": {
          "title": "Show Scrollmap",
          "description": "Show markdown heading and selected cell markers on the notebook scrollbar when the scrollmap package is available.",
          "type": "boolean",
          "default": true
        },
        "threshold": {
          "title": "Threshold",
          "description": "Hide scrollmap markers if their count exceeds this value. Zero means no limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "depth": {
          "title": "Depth",
          "description": "Maximum markdown heading depth to show in the scrollmap. Zero means no limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
